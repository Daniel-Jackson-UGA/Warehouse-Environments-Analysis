# ============================================================
# INTERPOLATE ONE TIMEPOINT
# ============================================================
interpolate_timepoint <- function(
timestamp,
data,
grid,
idp = 2
) {
# ----------------------------------------------------------
# Sensor observations for this timestamp
# ----------------------------------------------------------
sensor_data <- data %>%
filter(
Timestamp == timestamp
)
# ----------------------------------------------------------
# Interpolate temperature
# ----------------------------------------------------------
temperature <- interpolate_variable(
sensor_data,
grid,
"Temperature_F",
idp
)
# ----------------------------------------------------------
# Interpolate relative humidity
# ----------------------------------------------------------
humidity <- interpolate_variable(
sensor_data,
grid,
"Relative_Humidity_pct",
idp
)
# ----------------------------------------------------------
# Interpolate dew point
# ----------------------------------------------------------
dew_point <- interpolate_variable(
sensor_data,
grid,
"Dew_Point_F",
idp
)
# ----------------------------------------------------------
# Interpolate dew point depression
# ----------------------------------------------------------
dpd <- interpolate_variable(
sensor_data,
grid,
"Dew_Point_Depression_F",
idp
)
# ----------------------------------------------------------
# Combine the four interpolated fields
# ----------------------------------------------------------
result <- temperature %>%
left_join(
humidity,
by = c(
"X_ft",
"Y_ft",
"Z_ft"
)
) %>%
left_join(
dew_point,
by = c(
"X_ft",
"Y_ft",
"Z_ft"
)
) %>%
left_join(
dpd,
by = c(
"X_ft",
"Y_ft",
"Z_ft"
)
) %>%
mutate(
Timestamp = timestamp
)
result
}
test_time <- min(
data$Timestamp
)
test_field <- interpolate_timepoint(
timestamp = test_time,
data = data,
grid = interpolation_grid,
idp = idw_power
)
nrow(test_field)
names(test_field)
timepoints <- sort(
unique(data$Timestamp)
)
length(timepoints)
# ============================================================
# INTERPOLATE ALL TIMEPOINTS
# ============================================================
all_interpolated_fields <- lapply(
timepoints,
function(t) {
message(
"Processing: ",
format(t, "%Y-%m-%d %H:%M")
)
interpolate_timepoint(
timestamp = t,
data = data,
grid = interpolation_grid,
idp = idw_power
)
}
)
processed_environmental_fields <- bind_rows(
all_interpolated_fields
)
nrow(processed_environmental_fields)
table(
processed_environmental_fields$Timestamp
)
experiment_id <- "Wifi_Test_B_Farms"
experiment_id <- "Wifi_Test_July_22"
# ============================================================
# FINAL PROCESSED DATASET
# ============================================================
processed_environmental_fields_final <-
processed_environmental_fields %>%
mutate(
Experiment_ID = experiment_id,
Grid_Resolution_X_ft = grid_resolution_x,
Grid_Resolution_Y_ft = grid_resolution_y,
Grid_Resolution_Z_ft = grid_resolution_z,
IDW_Power = idw_power
) %>%
select(
Experiment_ID,
Timestamp,
X_ft,
Y_ft,
Z_ft,
Predicted_Temperature_F,
Predicted_Relative_Humidity_pct,
Predicted_Dew_Point_F,
Predicted_Dew_Point_Depression_F,
Grid_Resolution_X_ft,
Grid_Resolution_Y_ft,
Grid_Resolution_Z_ft,
IDW_Power
)
names(processed_environmental_fields_final)
head(processed_environmental_fields_final)
# ============================================================
# EXPORT PROCESSED ENVIRONMENTAL FIELD
# ============================================================
experiment_id <- "Wifi_Test_July_22nd"
